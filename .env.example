# Supabase Configuration
# 1. Go to https://supabase.com and create a project (or use an existing one)
# 2. Copy this file to .env.local:  cp .env.example .env.local
# 3. Replace the placeholder values below with your real Supabase credentials
#    - Find them in your Supabase dashboard under Settings > API
# 4. Run the SQL migration in supabase/profiles-migration.sql via the Supabase SQL editor
# 5. NEVER commit .env.local or real credentials to the repository

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# hCaptcha Configuration
# Get your site key and secret key from https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000000
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
